// Storybook's prefab gallery (not a game screen): a page of shared prefabs, and the match layout (the HUD, a clear
// window over the arena layer, the tray with the hand and the Prana bar). Styled in gallery.css.
prefab "gallery" {
    panel class="gallery" slot="items"
}
prefab "gallery-row" {
    panel class="gallery-row" slot="items"
}
prefab "gallery-label" {
    text class="gallery-label" bind="text"
}
prefab "gallery-box" {
    panel class="gallery-box" bind-class="anim" {
        text class="gallery-box-text" bind="text"
    }
}
prefab "gallery-spacer" {
    panel class="gallery-spacer" bind-class="size"
}
prefab "gallery-tray" {
    panel class="gallery-tray" slot="items"
}
