// Shared prefabs, prepended to every screen's KDL by screenUi (shared.ts); styled in shared.css. Build them with the
// binding builders in shared.ts (titleCard, signboard, card, ...), which turn content into bindings. Elements,
// attributes and bindings: docs/declarative-ui.md.

// A labelled button: btn(label, tap, state?). `state` becomes classes (primary, off).
prefab "btn" {
    button bind-class="state" tap="tap" {
        text class="shared-btn-label" bind="label"
    }
}

// The Kalinga Rush header: peach tracked label (and the banner score beside it), the gold yuga line (and the long die), the huge cream
// headline (two lines at most), a thin edge line. A new headline gets a new key, so title-card-in plays again.
prefab "title-card" {
    panel class="title-card" {
        panel class="title-card-top" {
            text class="title-card-label" bind="label"
            panel class="title-card-score" slot="score"
        }
        panel class="title-card-yuga" {
            text class="title-card-line" bind="line"
            panel class="title-card-die" slot="die"
        }
        panel class="title-card-headline" key=(bind)"headlineKey" {
            text class="title-card-headline-text" bind="headline"
        }
    }
}

// A lane's hanging signboard, at the midline: two cords, a frame-coloured board, the gold kicker (KSHETRA II), the
// cream title and the rule beneath. Veiled until its yuga: the kicker reads KSHETRA II · ? and nothing else shows.
prefab "signboard" {
    panel class="signboard" bind-class="state" {
        panel class="signboard-cords" {
            panel class="signboard-cord"
            panel class="signboard-cord"
        }
        panel class="signboard-board" {
            text class="signboard-kicker" bind="kicker"
            text class="signboard-title" bind="title" if="title"
            text class="signboard-rule" bind="rule" if="rule"
        }
    }
}

// A god card, 5:7. `variant` is its size (hand, next, face or detail) plus trimurti and discounted when they apply. The painted face (art,
// Pattachitra border in the class colour, gold leaf for the Trimurti) is the card-art element; the Prana cost sits in
// a diya badge top-left, the class sigil top-right, the names on the frame-coloured plate. Detail adds the rules.
prefab "card" {
    panel class="card" bind-class="variant" {
        card-art class="card-art" god=(bind)"god" paint=(bind)"paint" skin=(bind)"skin" trimurti=(bind)"trimurti"
        panel class="card-cost" {
            diya class="card-cost-diya" fill=1
            text class="card-cost-n" bind="cost"
        }
        sigil class="card-sigil" kind=(bind)"sigil" paint=(bind)"paint"
        panel class="card-plate" {
            text class="card-name" bind="name"
            text class="card-deva" bind="deva"
            text class="card-title" bind="title"
        }
        panel class="card-rules" slot="rules"
    }
}

// One line of a card's rules in detail: AVAHANA, NITYA or VISARJANA and what it does.
prefab "card-rule" {
    panel class="card-rule" {
        text class="card-rule-when" bind="when"
        text class="card-rule-text" bind="text"
    }
}

// The Prana row under the battlefield: ten diyas (lit ones are Prana to spend; the next one's flame grows as it
// charges) and the count.
prefab "prana-diyas" {
    panel class="prana" {
        panel class="prana-row" slot="diyas"
        text class="prana-count" bind="count"
    }
}
prefab "prana-diya" {
    diya class="prana-diya" fill=(bind)"fill"
}

// The banner score: each side's emblem and its three Dhvajas, raised or folded (lowered).
prefab "banner-score" {
    panel class="banner-score" {
        panel class="banner-score-side" slot="sun"
        panel class="banner-score-side" slot="moon"
    }
}
prefab "banner-score-emblem" {
    emblem class="banner-score-emblem" kind=(bind)"kind" paint=(bind)"paint" trim=(bind)"trim"
}
prefab "banner-score-flag" {
    flag class="banner-score-flag" bind-class="state" paint=(bind)"paint" trim=(bind)"trim" lowered=(bind)"lowered"
}

// The long die (pasaka) in the header: the current yuga's face, 4 to 1. Tap it to pause. A new face gets a new key,
// so yuga-turn plays.
prefab "long-die" {
    button class="long-die" tap="tap" {
        panel class="long-die-spin" key=(bind)"faceKey" {
            long-die class="long-die-face" face=(bind)"face"
        }
    }
}

// A Deva Katha page: cream textbook card, KATHA 07, the god's names, LEGEND or TRADITION in a Pattachitra border, the
// story, a seafoam Did-you-know box, a dotted fill-in, a red tick once unlocked, a Devanagari page number.
prefab "katha-page" {
    panel class="katha" {
        panel class="katha-top" {
            text class="katha-kicker" bind="kicker"
            tick class="katha-tick" on=(bind)"unlocked"
        }
        text class="katha-name" bind="name"
        text class="katha-deva" bind="deva"
        panel class="katha-label" {
            patta-border class="katha-label-border"
            text class="katha-label-text" bind="label"
        }
        text class="katha-text" bind="text"
        panel class="katha-know" {
            text class="katha-know-kicker" "Did you know?"
            text class="katha-know-text" bind="know"
        }
        text class="katha-fill" bind="fill"
        dots class="katha-dots"
        panel class="katha-foot" {
            text class="katha-source" bind="source"
            text class="katha-page-n" bind="pageN"
        }
    }
}

// The Leela Report: the cream progress-report card. Rows come in the rows slot (report-row), then the teacher's
// remark and the red rubber stamp (VIJAYA, PUNAH or SAMA; "Assisted" beneath when it was).
prefab "report-card" {
    panel class="report" {
        text class="report-kicker" bind="kicker"
        text class="report-title" "Leela Report"
        panel class="report-rows" slot="rows"
        text class="report-remark" bind="remark"
        panel class="report-stamp" bind-class="stamp" {
            text class="report-stamp-text" bind="stampText"
            text class="report-stamp-deva" bind="stampDeva"
        }
        text class="report-assisted" bind="assisted" if="assisted"
    }
}
prefab "report-row" {
    panel class="report-row" {
        text class="report-row-label" bind="label"
        text class="report-row-value" bind="value"
    }
}

// An emote: one of the four blessings, as a small pill.
prefab "emote" {
    panel class="emote" {
        text class="emote-text" bind="text"
    }
}
