// The title screen. Phase 1 holds it to a plain card of what the content holds; the title-card system replaces it.
// Styled in title.css.
prefab "title" {
    panel class="title" {
        text class="title-name" "Astras"
        text class="title-sub" "Unleashed"
        text class="title-count" bind="count"
    }
}
