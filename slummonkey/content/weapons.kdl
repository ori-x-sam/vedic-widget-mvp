// Weapons, EX shots and supers. kind = straight | spread | homing | arc.
weapon "coin" name="Coin Blaster" kind="straight" projectile="player-coin" rate=9 damage=4 speed=1500 range=1500 ex="ex-coin" \
  desc="Fake-token coins, straight and steady. Ka-ching!"
weapon "mirchi" name="Mirchi Spread" kind="spread" projectile="p-mirchi" rate=7 damage=2.6 speed=1100 count=3 spread=16 range=420 ex="ex-mirchi" \
  desc="Three hot chillies, short range. Close in, burn bright."
weapon "kabootar" name="Kabootar Seeker" kind="homing" projectile="p-kabootar" rate=6.5 damage=2.4 speed=760 range=1400 ex="ex-kabootar" \
  desc="Cyborg pigeons that find the target. Lower damage."
weapon "laddoo" name="Laddoo Lobber" kind="arc" projectile="p-laddoo" rate=3.6 damage=7 speed=900 range=1600 ex="ex-laddoo" \
  desc="Heavy sweet arcs. Great against things on the floor."

super "to-the-moon" name="To The Moon" kind="beam" dur=1.7 damage=150 desc="A rocket-beam straight ahead. Number go up."
super "diamond-hands" name="Diamond Hands" kind="invuln" dur=5 damage=0 desc="Hold. Nothing can hurt you for five seconds."
super "airdrop" name="Airdrop" kind="airdrop" dur=1 damage=16 desc="Crates rain down across the whole stage."

charm "extra-hp" name="Nimbu-Mirchi" effect="hp" value=1 desc="+1 HP. Wards off evil eyes (and one hit)."
charm "auto-parry" name="Lucky Thread" effect="parry-window" value=0.12 desc="Wider parry window."
charm "quick-blink" name="Overclock Chip" effect="blink-cd" value=-0.2 desc="Blink recharges faster."
charm "coin-magnet" name="Gullak" effect="meter" value=-25 desc="Fill super cards faster."

shop {
  weapon "mirchi" price=4
  weapon "kabootar" price=6
  weapon "laddoo" price=6
  super "diamond-hands" price=8
  super "airdrop" price=8
  charm "extra-hp" price=5
  charm "auto-parry" price=4
  charm "quick-blink" price=4
  charm "coin-magnet" price=5
}
