// Mela + sky minions. Each is a puppet plus a few words.
puppet "kettle" { part "k" svg="parts/minions/kettle" size=80 x=0 y=0 px=0.5 py=0.98 anim="bob" }
puppet "balloon" { part "b" svg="parts/minions/balloon" size=100 x=0 y=0 px=0.5 py=0.98 anim="float" }
puppet "anar" { part "a" svg="parts/minions/anar" size=74 x=0 y=0 px=0.5 py=0.98 anim="breathe" }
puppet "parrot" { part "p" svg="parts/minions/parrot" size=60 x=0 y=0 px=0.5 py=0.6 anim="float" }
puppet "kite" { part "k" svg="parts/minions/kite" size=90 x=0 y=0 px=0.5 py=0.6 anim="sway" }
puppet "gubbara" { part "g" svg="parts/minions/gubbara" size=300 x=0 y=0 px=0.5 py=0.98 anim="float" }
puppet "rickshaw" {
  part "body" svg="parts/minions/rickshaw" size=128 x=0 y=0 px=0.45 py=0.85 z=1 anim="bank"
  part "prop" svg="parts/minions/propeller" size=24 x=8 y=132 px=0.5 py=0.5 z=2 anim="prop"
}

minion "kettle" hp=10 w=70 h=75 gravity=2400 {
  loop { follow 150 dur=1.5; windup 0.3; lob 1 "water-drop" air=0.8 from="front" }
}
minion "balloon" hp=6 w=60 h=90 {
  move-to "me" 280 dur=2.2
  follow 120 dur=1.2 fly=#true
  windup 0.3
  ring 8 260 "pellet"
  despawn
}
minion "anar" hp=8 w=60 h=70 gravity=2400 {
  hop 140 3
  windup 0.45
  ring 10 320 "star"
  despawn
}
minion "parrot" hp=6 w=70 h=50 {
  par {
    fly-path "sine" dur=8 amp=60 speed=200
    loop { wait 1.1; windup 0.3; shoot "card" 380 }
  }
}
minion "kite" hp=10 w=70 h=80 {
  par {
    fly-path "sine" dur=10 amp=90 speed=230
    loop { wait 1.2; windup 0.3; shoot "kite" 380 }
  }
}
minion "pigeon-dive" hp=4 w=60 h=40 {
  fly-path "dive" dur=6 speed=320
}
minion "gubbara" hp=320 w=220 h=330 {
  move-to 330 120 dur=2
  parry-every 4
  loop {
    spiral 3 1.8 rate=6 speed=260 "pellet"
    wait 0.8
    homing 2 "pigeon" turn=70 speed=250
    wait 1
    hover 40 2 dur=2
    volley 5 50 380 "kite" from="mid"
    wait 1
  }
}
