// Touch layout defaults (landscape). x/y = fraction of the screen from the top-left; r = radius as a
// fraction of screen height; hit = touch zone multiplier (bigger than the art).
// Shooting is automatic (auto-aim), and parrying is jumping into something pink, so the right thumb
// only needs three buttons. The in-game layout editor saves overrides and can export this block as KDL.
controls {
  joystick zone=0.5 dead=0.22 radius=64          // floating stick anywhere in the left half
  button "jump"  x=0.885 y=0.76 r=0.125 shape="circle" icon="jump" hit=1.3     // biggest, at the thumb's resting point
  button "blink" x=0.735 y=0.83 r=0.09 shape="circle" icon="blink" hit=1.35   // DASH: left of JUMP
  button "ex"    x=0.80 y=0.50 r=0.075 shape="circle" icon="ex" hit=1.4       // SPECIAL: above, between them; glows when ready
  // Screen regions kept free of key threats (fractions from the bottom-left). Mirrors look/camera.css.
  safe-zone "left-thumb" x=0 y=0 w=0.22 h=0.27
  safe-zone "right-thumb" x=0.78 y=0 w=0.22 h=0.27
}
