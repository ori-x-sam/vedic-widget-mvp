// SlumMonkey's feel. Gameplay numbers only — colors and looks live in look/*.css.
player {
  speed 430          // run speed px/s
  gravity 2900
  jump 1080          // first jump velocity
  double-jump 940
  jump-cut 0.5       // releasing jump early cuts upward speed
  glide-fall 150     // tail-copter max fall speed while holding jump after the 2nd jump
  max-fall 1500
  blink-dist 230
  blink-cd 0.55
  blink-iframes 0.28
  hp 3
  cards 5            // super meter cards
  ex-cost 1
  meter-per-card 110 // damage dealt per card earned
  iframes 1.6
  parry-window 0.22
  parry-cd 0.3
  parry-bounce 950
  fly-speed 500      // autorickshaw (shmup)
  coyote 0.08
  hit-w 46
  hit-h 92
}
