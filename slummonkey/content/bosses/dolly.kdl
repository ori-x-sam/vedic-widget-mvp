// Boss 3 — Do-Tukdi Dolly, the girl who saws herself in half. All stage-prop: ribbons and confetti.
// Dolly stands inside the magician's two-part box: legs out the bottom, head and arms out the top.
puppet "dolly" {
  part "legs" shape="cyl" dim="16 46 16" x=6 y=40 pz=14 off="0 -20 0" color="--white" anim="kick"
  part "shoe" shape="box" dim="24 10 16" off="6 -44 0" color="--dolly-b" parent="legs"
  part "legs-b" shape="cyl" dim="16 46 16" x=-6 y=40 pz=-14 off="0 -20 0" color="--white" anim="kick" tags="b"
  part "shoe-b" shape="box" dim="24 10 16" off="6 -44 0" color="--dolly-b" parent="legs-b"
  part "bottom" shape="box" dim="100 66 90" y=36 off="0 33 0" color="--dolly-a" anim="breathe"
  part "diamond" shape="box" dim="30 30 4" off="-24 33 46" rot="0 0 45" color="--dolly-b" parent="bottom"
  part "diamond-2" shape="box" dim="30 30 4" off="24 33 46" rot="0 0 45" color="--white" parent="bottom"
  part "gap" shape="box" dim="110 8 100" y=104 color="--gold" emissive=0.15
  part "top" shape="box" dim="100 58 90" y=108 off="0 29 0" color="--dolly-b" anim="breathe"
  part "diamond-3" shape="box" dim="28 28 4" off="-24 29 46" rot="0 0 45" color="--dolly-a" parent="top"
  part "diamond-4" shape="box" dim="28 28 4" off="24 29 46" rot="0 0 45" color="--white" parent="top"
  part "arm-b" shape="box" dim="11 52 11" x=-4 y=190 pz=-40 off="0 -24 0" color="--skin-3" anim="arm" tags="b"
  part "torso" shape="ball" dim="52 46 42" y=164 off="0 18 0" color="--dolly-a" anim="head"
  part "head" shape="ball" dim="46 50 44" off="4 62 0" color="--skin-3" parent="torso"
  part "hair" shape="ball" dim="52 40 50" off="-6 76 0" color="--ink" parent="torso"
  part "fringe" shape="box" dim="10 12 44" off="22 80 0" color="--ink" parent="torso"
  part "eye" shape="box" dim="3 8 4" off="27 64 9" color="--ink" parent="torso"
  part "eye-2" shape="box" dim="3 8 4" off="27 64 -9" color="--ink" parent="torso"
  part "bindi" shape="ball" dim="5" off="27 74 0" color="--vermilion" parent="torso"
  part "smile" shape="box" dim="3 3 12" off="27 50 0" color="--chilli" parent="torso"
  part "ponytail" shape="cyl" dim="16 52 16" taper=0.5 x=-28 y=80 off="0 -22 0" color="--ink" anim="ponytail" parent="torso"
  part "bow" shape="gem" dim="20 14 30" off="0 4 0" color="--dolly-b" parent="ponytail"
  part "arm" shape="box" dim="11 52 11" x=4 y=190 pz=40 off="0 -24 0" color="--skin-3" anim="arm"
  part "bangle" shape="cyl" dim="15 5 15" off="0 -40 0" color="--gold" emissive=0.2 parent="arm"
}
puppet "dolly-legs" {
  part "legs" shape="cyl" dim="16 46 16" x=6 y=40 pz=14 off="0 -20 0" color="--white" anim="kick"
  part "shoe" shape="box" dim="24 10 16" off="6 -44 0" color="--dolly-b" parent="legs"
  part "legs-b" shape="cyl" dim="16 46 16" x=-6 y=40 pz=-14 off="0 -20 0" color="--white" anim="kick" tags="b"
  part "shoe-b" shape="box" dim="24 10 16" off="6 -44 0" color="--dolly-b" parent="legs-b"
  part "bottom" shape="box" dim="100 70 90" y=36 off="0 35 0" color="--dolly-a" anim="breathe"
  part "diamond" shape="box" dim="30 30 4" off="-24 35 46" rot="0 0 45" color="--dolly-b" parent="bottom"
  part "diamond-2" shape="box" dim="30 30 4" off="24 35 46" rot="0 0 45" color="--white" parent="bottom"
  part "cut" shape="box" dim="104 8 94" off="0 72 0" color="--gold" emissive=0.15 parent="bottom"
}
puppet "dolly-torso" {
  part "arm-b" shape="box" dim="11 52 11" x=-4 y=86 pz=-40 off="0 -24 0" color="--skin-3" anim="arm" tags="b"
  part "top" shape="box" dim="100 60 90" y=0 off="0 30 0" color="--dolly-b" anim="breathe"
  part "diamond-3" shape="box" dim="28 28 4" off="-24 30 46" rot="0 0 45" color="--dolly-a" parent="top"
  part "diamond-4" shape="box" dim="28 28 4" off="24 30 46" rot="0 0 45" color="--white" parent="top"
  part "cut" shape="box" dim="104 8 94" off="0 -2 0" color="--gold" emissive=0.15 parent="top"
  part "torso" shape="ball" dim="52 46 42" y=60 off="0 18 0" color="--dolly-a" anim="head"
  part "head" shape="ball" dim="46 50 44" off="4 62 0" color="--skin-3" parent="torso"
  part "hair" shape="ball" dim="52 40 50" off="-6 76 0" color="--ink" parent="torso"
  part "fringe" shape="box" dim="10 12 44" off="22 80 0" color="--ink" parent="torso"
  part "eye" shape="box" dim="3 8 4" off="27 64 9" color="--ink" parent="torso"
  part "eye-2" shape="box" dim="3 8 4" off="27 64 -9" color="--ink" parent="torso"
  part "bindi" shape="ball" dim="5" off="27 74 0" color="--vermilion" parent="torso"
  part "ponytail" shape="cyl" dim="16 52 16" taper=0.5 x=-28 y=80 off="0 -22 0" color="--ink" anim="ponytail" parent="torso"
  part "arm" shape="box" dim="11 52 11" x=4 y=86 pz=40 off="0 -24 0" color="--skin-3" anim="arm"
}
puppet "buzzsaw" {
  part "saw" shape="cyl" dim="170 10 170" detail=16 y=100 rot="90 0 0" color="--steel" anim="spin"
  part "hub" shape="cyl" dim="40 16 40" detail=8 rot="90 0 0" color="--steel-dark" parent="saw"
  part "tooth-1" shape="cone" dim="22 30 8" off="0 92 0" color="--white" parent="saw"
  part "tooth-2" shape="cone" dim="22 30 8" off="65 65 0" rot="0 0 -45" color="--white" parent="saw"
  part "tooth-3" shape="cone" dim="22 30 8" off="92 0 0" rot="0 0 -90" color="--white" parent="saw"
  part "tooth-4" shape="cone" dim="22 30 8" off="65 -65 0" rot="0 0 -135" color="--white" parent="saw"
  part "tooth-5" shape="cone" dim="22 30 8" off="0 -92 0" rot="0 0 180" color="--white" parent="saw"
  part "tooth-6" shape="cone" dim="22 30 8" off="-65 -65 0" rot="0 0 135" color="--white" parent="saw"
  part "tooth-7" shape="cone" dim="22 30 8" off="-92 0 0" rot="0 0 90" color="--white" parent="saw"
  part "tooth-8" shape="cone" dim="22 30 8" off="-65 65 0" rot="0 0 45" color="--white" parent="saw"
}
boss "dolly" name="Do-Tukdi Dolly" title="The Girl Who Saws Herself in Half" hp=1150 w=180 h=320 x=380 stage="dolly" theme="dolly" reward=40 \
  intro="Aadha show tumhara, aadha mera!" outro="Phir se jod do na, please?" {

  // The halves alternate: legs attack while the torso hovers, then the torso throws while the legs rest.
  phase "split" name="The Split" until="66%" {
    say "Dolly" "Ek, do... DO TUKDE!" dur=1.6
    split {
      part "legs" hp=200 x=120 w=120 h=200 puppet="dolly-legs" {
        wait 0.8
        loop {
          windup 0.7 pose="kick"
          charge 640
          stun 1.2 vuln=1.2
          hop 180 1
          wait 3.2
        }
      }
      part "torso" hp=200 x=400 y=170 w=150 h=170 puppet="dolly-torso" {
        parry-every 3
        wait 3.4
        loop {
          windup 0.5 pose="windup"
          volley 3 24 420 "knife"
          wait 1.0
          juggle 2 "club" 1.0 speed=440
          wait 1.0
          move-to "random" 170 dur=1
          wait 2.6
        }
      }
    }
    wait 99
  }

  phase "mirror-maze" name="Mirror Maze" until="33%" {
    reassemble
    say "Dolly" "Asli kaun? Sirf mera reflection jaanta hai." dur=2.2
    mirror-copies 3 { loop { wait 2.6; volley 1 0 320 "knife" } }
    loop {
      windup 0.5
      volley 2 16 360 "knife"
      wait 1.4
      windup 0.5
      spray 0.9 40 "card" rate=6 speed=360 from="mid" burst=2 pause=0.45
      wait 1.2
      swap-real dur=0.9
      wait 1.0
    }
  }

  phase "wrong-reassembly" name="Wrong Reassembly" {
    reassemble flip=#true
    say "Dolly" "Ulta jud gayi! Koi baat nahi, ulta hi sahi!" dur=2.2
    parry-every 3
    loop {
      windup 0.6
      cartwheel 460 dur=2.4
      stun 1.2 vuln=1.25
      windup 0.5
      volley 3 36 400 "knife" from="mid"
      wait 0.8
      drumroll 0.7
      ride-platform "buzzsaw" 300
      wait 0.8
      juggle 2 "club" 1.0
      wait 1.0
    }
  }
}
