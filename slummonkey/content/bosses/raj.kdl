// Final boss — Jadugar Raj. The magic show was a rug-pull all along.
puppet "raj" {
  part "cape" svg="parts/raj/cape" size=300 x=-10 y=310 px=0.5 py=0.03 z=1 anim="sway"
  part "arm-cards" svg="parts/raj/arm-cards" size=74 x=-30 y=230 px=0.06 py=0.65 z=2 anim="arm" tags="b"
  part "body" svg="parts/raj/body" size=270 x=0 y=0 px=0.5 py=0.98 z=3 anim="breathe"
  part "head" svg="parts/raj/head" size=190 x=8 y=250 px=0.4 py=0.82 z=4 anim="head"
  part "arm-wand" svg="parts/raj/arm-wand" size=56 x=34 y=226 px=0.05 py=0.5 z=5 anim="arm"
}
puppet "raj-giant" {
  part "chart-b" svg="parts/raj/chart" size=120 x=-260 y=420 px=0.5 py=0.5 z=1 anim="float" tags="b"
  part "body" svg="parts/raj/giant-body" size=540 x=0 y=0 px=0.5 py=0.99 z=2 anim="breathe"
  part "hand-b" svg="parts/raj/giant-hand" size=170 x=-210 y=300 px=0.45 py=0.0 z=3 anim="arm" tags="b"
  part "hand" svg="parts/raj/giant-hand" size=170 x=210 y=300 px=0.45 py=0.0 z=4 anim="arm"
  part "chart" svg="parts/raj/chart" size=110 x=250 y=520 px=0.5 py=0.5 z=5 anim="float"
}

boss "raj" name="Jadugar Raj" title="The Great Rug-Pull" hp=1700 w=160 h=380 x=380 stage="raj" theme="raj" reward=60 \
  intro="Swagat hai mere show mein... aakhri show!" outro="Pinky azaad!" {

  phase "showman" name="The Showman" until="75%" {
    say "Raj" "Taaliyaan! Aaj ka trick: tumhara gayab hona!" dur=2.4
    parry-every 5
    loop {
      spotlight 1
      spray 1.2 80 "card" rate=10 speed=450 from="front" burst=4 pause=0.3
      wait 0.6
      windup 0.4 pose="juggle"
      summon "rabbit" 3 from="hat" gap=0.3
      wait 0.8
      juggle 3 "prop" 1.4 speed=540
      wait 0.8
      teleport "far" 0
      wait 0.5
    }
  }

  phase "rope-trick" name="Indian Rope Trick" until="50%" {
    bg "raj-climb"
    say "Raj" "Rassi pe chadho, beta. Neeche mat dekhna!" dur=2.4
    move-to 0 250 dur=1
    rising-platforms 165
    scroll 0 70
    parry-every 4
    loop {
      hover 26 2 dur=1.6
      rain 6 "star" width=700 speed=380 warn=0.5
      wait 0.8
      homing 2 "pigeon" turn=70 speed=260
      wait 1.4
      volley 5 60 360 "card" from="mid"
      wait 1.2
      move-to "random" 250 dur=1.2
    }
  }

  phase "lota" name="Lota of Endless Water" until="25%" {
    bg "raj"
    say "Raj" "Yeh lota kabhi khaali nahi hota. Tairna aata hai?" dur=2.4
    move-to 380 250 dur=1
    rider "lota" keep-visible=#true x=-110 y=40
    buoyant 3 w=180
    flood 22 230
    parry-every 4
    loop {
      hover 20 1.6 dur=1.2
      beam 1.3 warn=0.8 angle="player" width=34 proj="water-jet"
      wait 0.7
      rain 7 "water-drop" width=800 speed=360 warn=0.5
      wait 1
      volley 3 30 420 "card" from="front"
      wait 1.2
    }
  }

  phase "reveal" name="The Reveal" {
    bg "raj-reveal"
    theme "raj-reveal"
    clear-stage
    puppet "raj-giant" w=380 h=520
    move-to 420 0 dur=0.1
    shake 20
    say "Raj" "Jaadu? Kaun sa jaadu? Yeh toh RUG PULL tha!" dur=2.6
    parry-every 4
    loop {
      graph-shot "pump-dump" 18 "candle-green" speed=270
      wait 1.3
      candles 4 warn=0.8 red=0.6
      wait 1.4
      rain 7 "cash" width=900 speed=400 warn=0.5
      wait 1
      graph-shot "rug" 16 "candle-green" speed=300
      wait 1.3
      homing 2 "pigeon" turn=60 speed=240
      wait 1
    }
  }
}
