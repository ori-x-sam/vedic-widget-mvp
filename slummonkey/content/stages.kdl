// Low-poly stages: each prop line is one set piece (src/view/stage3d.ts has one small function per kind).
// The game plays on the z=0 plane with the floor at y=0. z<0 is behind the action, z>0 in front of it.
// every=N repeats the piece every N px along x (every-y= along y) and wraps it around the camera forever.
// sky-top/sky-bottom default to --sky-<id>-top/bottom in look/stages.css. ambient/sun scale the lights.
//   kinds: deck ground backdrop curtain valance arch footlights crowd garland bunting star tube spot sun
//          palace palm tree bush hill rock fort lantern mirror poster chart cloud stall ferris tent pillar plain

stage "gajraj" ground="--wood" {
  prop "deck"
  prop "sun" x=380 y=520 z=-3200 s=2.2 color="--marigold" color2="--saffron"
  prop "hill" x=-1600 y=-80 z=-2600 w=1800 h=520 color="--clay"
  prop "hill" x=1500 y=-80 z=-2700 w=2000 h=600 color="--clay-dark"
  prop "palace" x=0 y=0 z=-1500 s=1.25 color="--paper" color2="--saffron"
  prop "palm" x=-820 y=0 z=-700
  prop "palm" x=-1250 y=0 z=-1100 s=1.2
  prop "palm" x=860 y=0 z=-650
  prop "palm" x=1300 y=0 z=-1000 s=1.3
  prop "garland" x=-330 y=470 z=-260 w=720 h=80
  prop "garland" x=390 y=470 z=-260 w=720 h=80 color2="--rani"
  prop "spot" x=-520 y=900 z=-120 rot=-18 w=200 h=1150 color="--sky-warm"
  prop "spot" x=560 y=900 z=-120 rot=18 w=230 h=1150 color="--marigold"
  prop "curtain" x=-800 y=0 z=-30 w=380 h=1000
  prop "curtain" x=800 y=0 z=-30 w=380 h=1000
  prop "valance" y=520 z=-40 w=3200
  prop "footlights" y=0 z=96 w=2600
  prop "crowd" y=-135 z=260 w=3000 n=1 color="--indigo"
}

stage "tigada" ground="--paper-dark" {
  prop "deck" color="--clay" color2="--clay-dark"
  prop "sun" x=-420 y=560 z=-3200 s=2.4 color="--white" color2="--turmeric"
  prop "hill" x=-1100 y=-120 z=-1900 w=1800 h=420 color="--turmeric"
  prop "hill" x=900 y=-140 z=-1700 w=1600 h=360 color="--paper-dark"
  prop "hill" x=0 y=-160 z=-2600 w=2600 h=520 color="--gold"
  prop "fort" x=300 y=0 z=-1300 w=1500 color="--clay" color2="--clay-dark"
  prop "palm" x=-760 y=0 z=-600
  prop "palm" x=900 y=0 z=-800 s=1.2
  prop "rock" x=-480 y=0 z=-420
  prop "lantern" x=-420 y=420 z=-200 color="--saffron"
  prop "lantern" x=0 y=450 z=-260 color="--teal"
  prop "lantern" x=440 y=420 z=-200 color="--saffron"
  prop "spot" x=-520 y=900 z=-120 rot=-18 w=200 h=1150 color="--sky"
  prop "spot" x=560 y=900 z=-120 rot=18 w=230 h=1150 color="--white"
  prop "curtain" x=-800 y=0 z=-30 w=380 h=1000 color="--peacock" color2="--indigo"
  prop "curtain" x=800 y=0 z=-30 w=380 h=1000 color="--peacock" color2="--indigo"
  prop "valance" y=520 z=-40 w=3200 color="--peacock"
  prop "footlights" y=0 z=96 w=2600
  prop "crowd" y=-135 z=260 w=3000 n=1 color="--peacock"
}

stage "dolly" ground="--rani" {
  prop "deck" color="--velvet-light" color2="--velvet-dark"
  prop "backdrop" x=0 y=0 z=-1400 w=5000 h=1600 color="--magenta"
  prop "mirror" x=-900 y=0 z=-1000 w=200 h=460
  prop "mirror" x=-450 y=0 z=-1100 w=200 h=460 color2="--dolly-b"
  prop "mirror" x=0 y=0 z=-1150 w=240 h=520
  prop "mirror" x=450 y=0 z=-1100 w=200 h=460 color2="--dolly-b"
  prop "mirror" x=900 y=0 z=-1000 w=200 h=460
  prop "star" x=-600 y=560 z=-500 color="--white"
  prop "star" x=-200 y=620 z=-700
  prop "star" x=250 y=580 z=-600 color="--white"
  prop "star" x=650 y=600 z=-500
  prop "garland" x=0 y=480 z=-300 w=1300 h=110 color="--dolly-b" color2="--white"
  prop "spot" x=-520 y=900 z=-120 rot=-18 w=200 h=1150 color="--pinky"
  prop "spot" x=560 y=900 z=-120 rot=18 w=230 h=1150 color="--dolly-b"
  prop "curtain" x=-800 y=0 z=-30 w=380 h=1000
  prop "curtain" x=800 y=0 z=-30 w=380 h=1000
  prop "valance" y=520 z=-40 w=3200
  prop "footlights" y=0 z=96 w=2600 color="--white"
  prop "crowd" y=-135 z=260 w=3000 n=1 color="--magenta"
}

stage "raj" ground="--raj-coat" ambient=1.05 {
  prop "deck" color="--raj-coat-light" color2="--midnight"
  prop "backdrop" x=0 y=0 z=-1600 w=5200 h=1800 color="--midnight"
  prop "chart" x=0 y=0 z=-1300 w=2200 n=16
  prop "poster" x=-1050 y=120 z=-1100 w=300 h=420 color="--rani" color2="--marigold"
  prop "poster" x=1050 y=120 z=-1100 w=300 h=420 color="--teal" color2="--saffron"
  prop "pillar" x=-700 y=0 z=-700 h=700 color="--raj-coat-light" color2="--gold"
  prop "pillar" x=700 y=0 z=-700 h=700 color="--raj-coat-light" color2="--gold"
  prop "star" x=-450 y=600 z=-500
  prop "star" x=-120 y=640 z=-700
  prop "star" x=220 y=610 z=-650
  prop "star" x=520 y=600 z=-500
  prop "spot" x=-520 y=900 z=-120 rot=-18 w=200 h=1150 color="--cyber"
  prop "spot" x=560 y=900 z=-120 rot=18 w=230 h=1150 color="--marigold"
  prop "curtain" x=-800 y=0 z=-30 w=380 h=1000 color="--raj-coat-light" color2="--raj-coat"
  prop "curtain" x=800 y=0 z=-30 w=380 h=1000 color="--raj-coat-light" color2="--raj-coat"
  prop "valance" y=520 z=-40 w=3200 color="--raj-coat-light"
  prop "footlights" y=0 z=96 w=2600
  prop "crowd" y=-135 z=260 w=3000 n=1 color="--raj-coat"
}

stage "raj-climb" ground="--white" sky-top="--sky-climb-top" sky-bottom="--sky-climb-bottom" {
  prop "deck" color="--raj-coat-light" color2="--midnight"
  prop "cloud" x=-500 y=200 z=-900 s=1.4 every=1100 every-y=700
  prop "cloud" x=0 y=500 z=-1700 s=2 every=1500 every-y=900
  prop "cloud" x=300 y=0 z=-450 s=0.9 every=1300 every-y=800
  prop "star" x=-450 y=600 z=-600 every=900 every-y=1100
}

stage "raj-reveal" ground="--midnight" ambient=0.75 sun=0.8 sky-top="--sky-raj-top" sky-bottom="--candle-red" {
  prop "deck" color="--midnight" color2="--velvet-dark"
  prop "chart" x=0 y=-200 z=-1500 w=3200 n=20
  prop "chart" x=-500 y=-100 z=-2300 w=2600 n=14
  prop "spot" x=-520 y=900 z=-120 rot=-18 w=200 h=1150 color="--candle-red"
  prop "spot" x=560 y=900 z=-120 rot=18 w=230 h=1150 color="--candle-green"
  prop "curtain" x=-800 y=0 z=-30 w=380 h=1000
  prop "curtain" x=800 y=0 z=-30 w=380 h=1000
  prop "footlights" y=0 z=96 w=2600 color="--candle-red"
  prop "crowd" y=-135 z=260 w=3000 n=1 color="--velvet-dark"
}

stage "mela" ground="--leaf" {
  prop "ground" color="--leaf" color2="--leaf-dark" w=3100 every=3000
  prop "hill" x=0 y=-150 z=-3200 w=2200 h=700 color="--leaf" every=1900
  prop "hill" x=700 y=-150 z=-2600 w=1600 h=500 color="--leaf-dark" every=1700
  prop "ferris" x=600 y=0 z=-1500 s=1.3 every=3600 color="--rani"
  prop "tent" x=-200 y=0 z=-1100 s=1.1 every=1300
  prop "tree" x=200 y=0 z=-700 every=900
  prop "stall" x=0 y=0 z=-380 every=640
  prop "bunting" x=320 y=430 z=-240 w=640 h=50 every=640
  prop "lantern" x=0 y=470 z=-120 every=640 color="--marigold"
  prop "bush" x=100 y=-50 z=210 every=430
}

stage "shmup" ground="--leaf" {
  prop "plain" y=-700 color="--leaf"
  prop "sun" x=0 y=500 z=-3800 s=2.6 color="--white" color2="--marigold"
  prop "hill" x=0 y=-700 z=-3400 w=2600 h=760 color="--leaf" every=2200
  prop "hill" x=1100 y=-760 z=-3000 w=1800 h=600 color="--leaf-dark" every=2500
  prop "cloud" x=0 y=420 z=-1800 s=2.2 every=1400
  prop "cloud" x=500 y=120 z=-1300 s=1.6 every=1700
  prop "cloud" x=200 y=560 z=-700 s=1.1 every=1500
  prop "cloud" x=900 y=-60 z=-600 s=1.2 every=1900
  prop "cloud" x=300 y=330 z=380 s=0.9 every=2300
}
