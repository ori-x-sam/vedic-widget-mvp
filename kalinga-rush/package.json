{
  "name": "kalinga-rush",
  "private": true,
  "version": "0.1.0",
  "description": "A one-button runner through 3,500 years of Kalinga / Odisha history.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:colours": "tsx tools/check-colour-literals.ts",
    "test": "vitest run",
    "qa:colour": "tsx tools/colour-qa.ts",
    "check": "npm run typecheck && npm run lint:colours && npm run test"
  },
  "dependencies": {
    "@fontsource/baloo-bhaina-2": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "playwright-core": "1.64.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
