// The title: the name, the line under it, and the way in. Styled in title.css; bindings in title.ts.
prefab "title" {
    panel class="title" {
        panel class="title-top" {
            text class="title-name" "JYOTSNA MAHAL"
            text class="title-odia" "ଜ୍ୟୋତ୍ସ୍ନା ମହଲ"
            text class="title-line" "Seven nights to the full moon"
        }
        panel class="title-buttons" slot="buttons"
        text class="title-foot" "Orissa States, 1946. A mystery in the first person. Headphones help."
    }
}
