// Every model the view loads: models/<id>.py builds models/<id>.glb (`npm run models`), and these are the palette
// tokens its four materials are tinted with (src/screens/shared.css :root). Colour is value-painted into the model's
// vertices in Blender; the hue comes from here, so a designer recolours a model without opening Blender.
//   model "id" body="--token" trim="--token" cloth="--token" glow="--token" scale=1
// Materials a model doesn't use can be left out.

// ---------- the guest room ----------
model "charpoy" body="--teak" trim="--teak-dark" cloth="--jute"
model "steamer-trunk" body="--trunk-canvas" trim="--brass" cloth="--trunk-leather"
model "punkah" body="--teak" cloth="--punkah-cloth" trim="--brass"
model "punkah-cleat" body="--teak-dark" cloth="--jute" trim="--brass"
model "dressing-table" body="--teak" trim="--brass" glow="--mirror" cloth="--paper"
model "almirah" body="--teak" trim="--brass"
model "rug" body="--rug" cloth="--rug-border"

// ---------- the corridor ----------
model "pillar" body="--sandstone" trim="--sandstone-dark"
model "door-leaf" body="--teak" trim="--brass"
model "calendar-print" body="--paper" cloth="--oleograph" trim="--brass"
model "curtain-alcove" body="--sandstone" cloth="--curtain"

// ---------- the trophy gallery ----------
model "trophy-leopard" body="--leopard" trim="--teak-dark" glow="--glass-eye" cloth="--brass"
