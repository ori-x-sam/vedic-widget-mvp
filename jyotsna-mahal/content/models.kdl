model "raja" body="--skin-raja" cloth="--achkan" trim="--safa" glow="--jewel"
model "ghatak" body="--skin-ghatak" cloth="--ghatak-suit" trim="--moustache"
model "mrs-ghatak" body="--skin-mrs-ghatak" cloth="--mrs-ghatak-sari" trim="--moustache" glow="--sari-border-dark"
model "sahukar" body="--skin-sahukar" cloth="--sahukar-suit" trim="--topi" glow="--cigar"
model "mrs-sahukar" body="--skin-mrs-sahukar" cloth="--mrs-sahukar-sari" trim="--moustache" glow="--sari-border"

// ---------- the day ----------
