model "plaque-stand" body="--teak-dark" trim="--brass-new"
model "photo-table" body="--teak" trim="--silver" cloth="--velvet"
model "portrait" body="--portrait" trim="--gilt" cloth="--achkan"
model "bear-standing" body="--bear" trim="--teak-dark" glow="--glass-eye"
model "chandelier-dead" body="--brass" trim="--brass" glow="--crystal"
model "tiger-rug" body="--tiger" cloth="--tiger-stripe" glow="--glass-eye"

// ---------- the storeroom ----------
model "skin-rack" body="--teak-dark" cloth="--old-skin" trim="--brass"
model "workbench" body="--teak" trim="--iron" cloth="--tiger"
